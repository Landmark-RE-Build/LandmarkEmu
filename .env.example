# LandmarkEmu settings. Copy this file to .env, fill it in, and run:  docker compose up -d --build
# After changing a setting, run  docker compose up -d  again.
# (Lines starting with # are notes. Write values with no spaces around the =.)
# Every game setting below defaults to how live Landmark was (the note says "live" and the source); the extras that go
# beyond live are off. Change any of them for your own server.
# Admins can also change most settings in game on the admin Settings page (/admin -> Server settings). Those are kept in
# the world's data folder (server-data/worlds/<WORLD_KEY>/settings-overrides.json) and win over this file; the page's
# "Reset to .env" hands a setting back to this file (docs/admin.md "Settings page").

# ---- Network ---------------------------------------------------------------------------------------------------------

# The address players on OTHER PCs use to reach this PC:
#   - empty: this PC only (127.0.0.1);
#   - your LAN IP (e.g. 192.168.1.20) for players on your home network;
#   - a VPN address (Tailscale, ZeroTier) or your public IP / host name for players elsewhere.
# The world server tells every game this address, so it must be one they can reach.
PUBLIC_HOST=

# Ports. Players need all but DB_PORT open (Windows Firewall, and port forwarding on your router for players outside
# your home network). Each is published on the same port number inside the container, except ACCOUNT_PORT, which
# always maps to the auth container's port 5000.
# On Windows, if compose fails with "port is forbidden" / "excluded", Hyper-V has reserved that host port
# (check: netsh interface ipv4 show excludedportrange protocol=tcp). Pick a free port outside those ranges —
# 5000 often sits inside 4923-5022; 5050 is a common substitute for ACCOUNT_PORT.
# Login server (UDP): the game logs in here.
LOGIN_PORT=20042
# Account service (TCP): LaunchPad and the website create accounts and log in here.
ACCOUNT_PORT=5000
# World server (UDP): the game world.
WORLD_PORT=19000
# In-game web pages (TCP): the Showcase, store and Player Studio windows.
WEB_PAGES_PORT=19001
# Account sign-up website (TCP): http://<PUBLIC_HOST>:<WEBSITE_PORT>/
WEBSITE_PORT=8080
# The database, reachable from this PC only (for tools like HeidiSQL); never open it to others.
DB_PORT=3307

# ---- Your game -------------------------------------------------------------------------------------------------------

# Your Landmark folder, the one with Landmark64.exe (forward slashes work on Windows). It is mounted read-only: the
# servers copy their data tables from it and nothing in it is changed.
GAME_DIR=C:/Program Files (x86)/Steam/steamapps/common/Landmark

# ---- Database passwords ----------------------------------------------------------------------------------------------

# Choose two long random passwords before the first start (letters and digits). They are only used between the
# containers, so you never type them anywhere else. Changing them later needs the database to be reset.
DB_ROOT_PASSWORD=
DB_PASSWORD=

# ---- Your world ------------------------------------------------------------------------------------------------------

# Short name: the world's database is lmemu_world_<WORLD_KEY>, its files are in server-data/worlds/<WORLD_KEY>.
WORLD_KEY=main
# Its id in the server list (1, 2, 3...; unique per world, never reused).
WORLD_ID=1
# Its name in the server list, a client text id: 62147 Dev Server, 560911 Courage, 560912 Liberation,
# 560913 Satisfaction (EU), 560914 Understanding (EU), 560915 Rebellion, 560916 Serenity, 560917 Determination,
# 560918 Confidence, 560919 Adventure, 560920 Gratitude, 560921 Prosperity, 560922 Success, 560923 Triumph,
# 560925 Opportunity, 560926 Inspiration. Default 560916 Serenity.
WORLD_NAME_ID=560916
# The world's name in game (Landscapes window, zone and group details), a client text id. 0 = as live, the world's own
# name: WORLD_NAME_ID when it is one of the live names above (560911-560926), else 560912 Liberation.
CLIENT_WORLD_NAME_TEXT=0
# The world id the game client is told. 0 = 2, as live's capture. Only worlds sharing one gateway (travel between
# worlds, docs/docker.md) need their own; never 3 (the Events world).
CLIENT_WORLD_ID=0
# Players allowed in the world at once; more logins wait in the login queue, members first. 0 = no limit (live queued
# logins; its cap is not known).
MAX_PLAYERS=0

# Admins (optional bootstrap): day-to-day staff live in the auth DB table admin (SQL: INSERT INTO admin (entry)
# VALUES ('account:Alice'); see docs/admin.md). The lines below are OR'd with that table for a first admin or emergency.
# Write each as account:<account name> or character:<character name> (e.g. ADMIN_ACCOUNT=account:Alice): then only that
# kind of name is checked. A bare name still works but is ignored while an account and another player's character share
# it. ADMINS: any number more, comma separated (e.g. account:Alice,character:Bob).
ADMIN_ACCOUNT=
ADMIN_2=
ADMIN_3=
ADMINS=
# Push the instanced-games admin monitor page to admins while a site game runs (false = only when they ask for it).
ADMIN_MONITOR_PUSH=false
# The admin page's test commands that run code or raw packets inside a player's game (lua, luacode, luas, send). false
# (default, keep it): they only reach the admin who runs them and other admins, and they can't use the game's functions
# that open the player's own web browser on their desktop. true lets an admin run code in ANY player's game, which
# can open web pages on that player's PC: only for a test server where every player agreed. Every use is logged.
DEV_CLIENT_CODE_ON_OTHERS=false

# Message of the day, shown once per login: subject and text (your server's own; leave both empty for none).
MOTD_SUBJECT=Welcome to Landmark
MOTD_BODY=This server is LandmarkEmu, a fan-made recreation. Have fun building!

# Scheduled restarts with in-game warnings. Empty (default) = none. Live restarted every Monday and Saturday at 3 a.m.
# Pacific from June 2016: set "Mon,Sat 03:00" for that ("Daily 05:00" works too). The world container starts again by
# itself after each one.
RESTART_SCHEDULE=
RESTART_TIME_ZONE=America/Los_Angeles
# How long before a scheduled restart the warnings start (seconds; 3600 = from an hour before), and their text.
RESTART_WARNING_SECONDS=3600
RESTART_MESSAGE=Scheduled server restart.
# Also send each shutdown / restart warning as a "System Broadcast" (on-screen text and a chat line). false = live (only
# the client's own shutdown countdown).
SHUTDOWN_BROADCASTS=false
# Send the client's kick warning packet before an admin kick and in a shutdown's last 30 seconds (it turns the game's
# sound back up; a readable chat line always goes with it, the packet's own text is empty in the retail client).
PENDING_KICK_PACKET=true
# "[player] is not online at this." (Teleport to Friend to an offline friend, a trade or inspect target that left):
# false = a system line with the target's name; true = the client's own packet, whose line shows your own name instead.
TARGET_NOT_ONLINE_PACKET=false
# Close a crafting / repair station's window when its player walks more than 8 m away or the station is picked up (true).
CRAFTING_WINDOW_CLOSE_AWAY=true
# A world whose server tick hangs for this many seconds ends itself and restarts (0 = never).
WATCHDOG_SECONDS=180
# A player whose game client goes silent this many seconds (a crash, a killed process, Alt+F4, power or network loss)
# is disconnected and leaves the world at once, so others stop seeing them. 60 = two of the client's 29 s keep-alives
# (below 30 counts as 30; 0 = never). Read by the world and by the gateway container alike.
CLIENT_TIMEOUT_SECONDS=60

# Build and place props anywhere, without a build site. false = live (only where you have build permission); true for
# creative or test servers.
FREE_BUILD=false
# Shift's sprint and the boot abilities (Nimbus double jump, Boots of Bounding / Leaper's Launchers leaps, Breeze Boots
# glide, Neon Blitzing charge) carry the movement effects the game client runs: true = live (without them those keys
# do nothing). On, sprint / Immediate Delivery / Breeze glide last while their key is held, and the boots cost Energy
# and have cooldowns (2014 developer values).
MOVEMENT_EFFECTS=true
# Melee weapon swings run as the game client's sweep: the client reports the opponents its swing passes through and the
# server checks each against its own swing cone before the hit lands. true = live; false = the server alone decides every
# swing (as before 2026-10-18).
MELEE_TARGETERS=true
# A blocking stance (Molten Rebuke, Corrupting Revenge, a creature's shield block) is shown to the other players' game
# clients: their melee swings stop on the blocker and show the "blocked" effect. true = live; false = nothing is sent
# (the server still blocks the damage, but others see their swing pass through).
BLOCK_STANCE_VISIBLE=true
# A dead player's body lies down on the other players' game clients (the client shows a death pose only when told the
# character is knocked out). true = live; false = nothing is sent (the dead player stands on the others' screens).
DEAD_BODIES_VISIBLE=true
# When a flinger, launcher or thrust pad throws you, your client marks you "launched" and tells the server; the server
# ends that state when you land, so every later launch behaves like the first. true = live; false = only logged.
SAFE_EJECT_RESET=true
# The character stats live sent: your own movement tuning at login (slower backpedal / strafe, speed-up and slow-down
# times) and the speed-up / slow-down times other players' animations use. true = live.
LIVE_CHARACTER_STATS=true
# Placed props are sent to each player only within this many metres (in 64 m squares, nearest first, at zone-in and as
# they move) and taken away again 80 m further out, instead of every prop on the landscape after every loading screen.
# 400 = the game's Render Distance slider at its last bounded step (99 %); a player on "unlimited" sees props appear at
# 400 m. 0 = every placed prop of the landscape, as before 2026-10-18. Live's own range is not known.
PROP_STREAM_RANGE=400
# While a player's loading screen is up (login or a long trip), creatures, trees, chests, outposts, warp crystals and the
# placed props away from where they stand wait until the screen drops (at most STREAM_HOLD_LIMIT_SECONDS), then come all
# at once. Works around the game's own 64-slot memory limit on PCs with 16 or more CPU threads, where loading could crawl
# at 50 % for a long time ("Avg contour" lines in the game's log). Only the order changes. false = everything at once,
# as before 2026-10-21.
STREAM_HOLD_UNTIL_LOADED=true
# The longest that hold lasts, in seconds (10-600), for a game that never reports its loading screen down.
STREAM_HOLD_LIMIT_SECONDS=90
# The Escape menu's "Evac to Safety" moves players: onto the ground where they stand, or just off the build site they
# stand on. true = live; false answers players' requests in place (admins' /location and map teleports still work).
PLAYER_TELEPORT_REQUESTS=true
# The home (starting) landscape's continent: 406 Sleeping Ridge, as live's capture. The world and the Environment Server
# both read this line.
HOME_CONTINENT=406
# Coarse (distance) copies of build edits, so builds stay visible from afar: true = live. Keep the smooth-surface
# (vertex-only) voxels the game sends with edits: true. The world and the Environment Server both read these lines.
TERRAIN_LOD_COPIES=true
KEEP_VERTEX_ONLY_VOXELS=true

# Whose "Landmarks of Landmark" (contest-winning builds beside every Spire) this world shows: auto = the live world
# named by WORLD_NAME_ID (Courage, Determination, Liberation, Rebellion or Serenity), else Courage; or one of those
# names, or off. Each landscape keeps the landmark it was given first.
LANDMARKS_WORLD=auto

# Which landscapes' Chaos Caverns Travel -> An Underground Adventure and the Lost Crystals' trips use: all (every
# non-Pioneer island, as live from June 2016), home (the home continent only) or zone ids, e.g. 406,391,393. Another
# landscape's outposts are built into its caverns in the background the first time someone is there (a few minutes,
# ~110 MB of terrain files each); OUTPOST_PRELOAD=true builds the unvisited landscapes too, one after another.
CAVERN_LANDSCAPES=all
OUTPOST_PRELOAD=false
# Surface graveyards (the map's red circles): Flee sites with a 30 m buffer creatures leave alone, where no build site can
# be placed. Their spots are ours (one per 1 km of level land; no client file places them); false = only the Chaos
# Caverns' graveyards (always on) and the Spire.
SURFACE_GRAVEYARDS=true
# The area round each Spire (90 m, from the game files): no build sites, no mining or harvesting, no trees, as live after
# October 2014. false = only the Spire's platform is kept clear and build sites may be placed right next to it.
SPIRE_AREA=true
# The Chaos Caverns' graveyards built into the terrain as on live: the client's graveyard_launch template (a raised
# plinth with gravestones, glowing mushrooms and four gargoyles) at each of a landscape's 81 graveyard spots, written
# once in the background on the landscape's first visit (a few MB of terrain files) and never again. false = no new
# stamps: a graveyard not built yet is only its centrepiece on the cave floor; ones built earlier stay.
CAVERN_GRAVEYARD_STAMPS=true
# A player who falls through the world in the first 30 seconds after an Underground Adventure (more than 12 m below the
# graveyard they arrived on, where no cave floor is) is put back on that graveyard behind a loading screen; a second fall
# goes to the landscape's shallowest graveyard. Ours (what live did is not known); false = they are left where they fell.
CAVERN_ARRIVAL_RESCUE=true
# Outposts change caverns ("Outposts exist in the open world and change regularly", the client's help page): every
# OUTPOST_ROTATION_HOURS hours per landscape, OUTPOST_ROTATION_SHARE of its outposts (0.25 = a quarter) get another ruin
# in their own cavern, built in the background; an outpost a player is near is left for the next time. Live's period is
# not known: 0 = never (the default), e.g. 84 = about twice a week.
OUTPOST_ROTATION_HOURS=0
OUTPOST_ROTATION_SHARE=0.25
# Creatures in the Chaos Caverns and outposts walk around cave rock and ruin walls instead of through them (and surface
# creatures off build sites around cliffs). false = they step straight at their target, as before.
CREATURE_PATHING=true
# Story creatures on build sites walk around player-built walls (through doorways), dug holes and placed props such as
# trees and rocks, as on live; false = they step straight at their target, as before. Needs CREATURE_PATHING.
SITE_PATHING=true
# Creatures hold a weapon in their hand (story creatures only while their weapons are Equipped). On by default. It is a
# best guess: the game files say which kind of weapon each creature carried (its icon in the prop list: bow, sword,
# staff, daggers, blaster ...) but not the exact weapon model live gave it, so the server picks a fitting one (the
# players' weapon of the creature's element where there is one). Animals and monsters hold nothing. false = no
# creature weapons.
CREATURE_WEAPONS=true
# Trees (and plants) after they are cut. minmax = as live (a developer's post, June 2015): each kind of tree has a
# minimum and a maximum per landscape; while a kind is above its minimum nothing grows back; below it, one grows back
# after the placement's respawn minutes (12-18 on most) at another random free spot of the same kind, not where it was cut.
# The maximum is every spot the placement makes, the minimum PROCEDURAL_RESPAWN_MIN_SHARE of it (0.67 = two thirds).
# inplace = the older way: every cut tree grows back where it stood.
PROCEDURAL_RESPAWN=minmax
PROCEDURAL_RESPAWN_MIN_SHARE=0.67
# How trees are cut down. health = as live: every tree has health by its size (from the game files: very small trees
# 350, small 750, medium 1500, large 2250, very large 3000), each axe swing takes the axe's damage off it (80 with the
# Adventurer's Axe: 5 to 38 swings, 10 to 29 on the default tree lists) and the player chopping it sees the tree's
# health bar.
# hits = the older way: every tree falls after 5 swings (8 for large ones), with no health bar.
TREE_HEALTH=health
# Where trees stand. false (default) = the server's per-biome tree lists. true = the game files' own placement sets and
# masks; those were made for the 2014 alpha biomes, so live's launch placement is not in the game files and which is
# closer to live is not known. DECOR also places the sets' rocks, bushes and flowers (not gatherable); MASKS = use the
# sets' mask pictures.
PROCEDURAL_PLACEMENT=false
PROCEDURAL_PLACEMENT_DECOR=false
PROCEDURAL_PLACEMENT_MASKS=true
# The island on the teleport menu's "Events" world (0.695 clients): auto (live's 2016 dates: Halloween Party 3 Oct -
# 20 Nov, Winter Holiday 21 Nov - 10 Jan), halloween, winter, judgement or off; read at start-up. Default auto = live.
EVENT_ISLAND=auto
# true = when the island changes between two runs, the build sites left on the island that closed expire like sites
# whose upkeep ran out (a Design saved, the ground reverted, props and resources mailed to the owner), as live did.
# This deletes players' builds: back up first. false = they stay. The dev command "eventexpire" lists what would expire.
# Default true = live.
EVENT_ISLAND_EXPIRE_ON_CLOSE=true
# true = build sites still on the old Pioneer lands 417-421 (this server's Pioneer lands before 2026-10-17; live's are
# 464-468) move at start-up to the land of the same biome (417->464, 418->466, 419->465, 420->467, 421->468), keeping
# their name and access; a Design of the old build is saved, the old voxels and props stay behind unseen. false = they
# stay (unreachable). Default true.
MOVE_OLD_PIONEER_SITES=true
# The slate slab under each new Pioneer site (live fixed how that slab is placed on new player sites: update notes 30
# Jun 2016),
# from the client's own templates: claim3x3 (default; a 2 m slab over the 210 m site, plus-shaped, the corners left as
# ground) | claim1x1 (only the site's 70 m middle) | off. Stamped once, flush with the ground, on sites granted from now
# on. The material is a VoxelMaterials ARRAY_INDEX: 26 = Worked Slate (default); 0 = the template's own index 53.
PIONEER_SLAB=claim3x3
PIONEER_SLAB_MATERIAL=26
# Seasonal outfit drops from Outposts / Reward Chests: auto (live's 2016 calendar: Halloween 28 Sep - 5 Dec, Winter
# 6 Dec - 10 Jan; default) | halloween | winter | off.
LANDMARK_SEASON=auto
# Ninja Mask / Samurai Helmet unlocker drops: season (live: only during the Halloween season; default) | always | off.
HAT_DROPS=season

# The Showcase store. false = as live: only what the live Marketplace sold in 2016 (Build Site Expansion, Fantasy Parlor
# Pack, pets, the bigger Reward Chests), paid in Lumens (live's Daybreak Cash price x LUMENS_PER_DBC; 1.3 = live's own
# Lumen price); outfits, props and recipes come from the Lumen Station and exploring. true = everything free (creative
# or test servers). Nothing is ever paid with real money.
FREE_STORE=false
LUMENS_PER_DBC=1.3
# Your own store prices in Lumens: "item id=Lumens" pairs, comma separated (e.g. 900001=500,2551=1300; 0 = free). It
# replaces a live product's price, or adds any item of the catalogue to the store. Empty = live's prices only.
STORE_PRICES=
# Player Studio designs on the Showcase cost the creator's price x LUMENS_PER_DBC Lumens (free with FREE_STORE=true);
# the creator is mailed this percent of what the buyer paid (live: a 60/40 split, the creator's side 40).
PLAYER_STUDIO_CREATOR_SHARE=40
# Player Studio listing fee when a design is submitted, as live: 10% of the price, at least 100 Daybreak Cash, in Lumens
# at LUMENS_PER_DBC (13%, at least 130 Lumens); kept if peer review rejects the design. false = no fee (none with
# FREE_STORE=true either).
PLAYER_STUDIO_LISTING_FEE=true
# Player Studio peer review: approvals that list a design, and rejections that turn it down (live's numbers are not
# known). Used by the world, or by the commerce service when COMMERCE_ADDRESS is set.
PLAYER_STUDIO_APPROVALS=3
PLAYER_STUDIO_REJECTIONS=3
# Who may review: accounts that spent at least this much Daybreak Cash (x LUMENS_PER_DBC = Lumens) on the store and on
# Player Studio designs (live: only players who had bought 1000 SC or more on the Marketplace, update notes 18 Jun
# 2014); 0 = anyone.
# Reviews per player per 24 hours (live: two a day; 0 = no limit). PLAYER_STUDIO_STAFF_REVIEW=true (live): a design the
# peers reject waits in the admin page's staff list (/admin, Player Studio) for an admin to approve or reject; false =
# rejected at once.
PLAYER_STUDIO_REVIEWER_MIN_SPEND=1000
PLAYER_STUDIO_REVIEWS_PER_DAY=2
PLAYER_STUDIO_STAFF_REVIEW=true
# A reviewer whose rejections staff overturned (a design they rejected that an admin then approved) this many times is
# offered no more reviews: live, a reviewer whose rejection Daybreak's staff disagreed with "will stop getting items to
# review" (wiki Player Studio). 1 = live (the count is ours); 0 = never held back.
PLAYER_STUDIO_REVIEWER_OVERRULES=1
# Player Studio designs take no design storage: the copies bought from Player Studio and a creator's designs that are on
# it (waiting for review or listed). true = as live (wiki Designs: bought designs don't count toward the limit; developers,
# Hotfix Notes 17 Oct 2014: designs submitted to Player Studio no longer count against Voxel Storage); false = they count.
PLAYER_STUDIO_DESIGNS_FREE_STORAGE=true
# Designs belong to the account: when a character is deleted, its designs (and the designs made of its build sites) go
# to the account's next character at its world entry. true = as live (developers, Landmark Wipe Q&A 14 Mar 2016: designs
# "are tied to your account, not your character"); false = they stay with the deleted character.
DESIGNS_FOLLOW_ACCOUNT=true
# Founder's Pack, Year Zero and promotional items (flags, Void Vault, founder pickaxes and outfits, Year Zero trophy and
# outfit, Iron Portcullis, Fan Faire souvenirs) for every character, once (true, this server's choice; live gave them
# only to buyers, Year Zero survivors and winners). false = nobody gets them and their props leave the prop palette.
# ENTITLEMENT_PACKAGES picks founder / yearzero / promo. ENTITLEMENT_DELIVERY: auto = as live (Founder's Pack items
# into the bag, Year Zero gifts and promo items by mail), mail, bag, or per package (e.g. founder=bag,promo=bag).
FOUNDER_ENTITLEMENTS=true
ENTITLEMENT_PACKAGES=founder,yearzero,promo
ENTITLEMENT_DELIVERY=auto
# Players allowed on one landscape at once; more arrivals from the Landscapes window wait in the client's travel queue
# ("This location is currently full") until a place frees. 0 = no limit.
LANDSCAPE_CAPACITY=0
# Membership: bought with Lumens (/membership buy, or the Showcase store) for MEMBERSHIP_DAYS days at
# MEMBERSHIP_PRICE_LUMENS (0 = not for sale). Every account is mailed one trial key ("Invite your friends!", as live
# from 29 Aug 2016) that can be mailed once to a friend; used, it gives the friend's account TRIAL_KEY_DAYS days of
# trial membership. TRIAL_KEYS=false sends no keys and keys can't be used.
MEMBERSHIP_PRICE_LUMENS=1950
MEMBERSHIP_DAYS=30
TRIAL_KEYS=true
TRIAL_KEY_DAYS=10
# Player vendor shops on the Vendor Booth prop. false = as live (decorative since 1 Apr 2016); true = a working shop
# stocked from the Showcase's "My vendors" page.
VENDOR_SHOPS=false
# In build mode, right-clicking a prop shows its name over it (its own name if the owner renamed it) while the menu is
# open; only the player who opened the menu sees it. The game doesn't tell the server when the menu closes, so the name
# goes with the next thing done to a prop, another right-click, leaving build mode, or after 10 seconds. false = no name.
BUILD_MENU_PROP_NAME=true
# Storage chests one account may have placed over all its build sites. 0 = no account cap (as live: the update notes of
# 21 Mar 2016 cap chests at 50 per build site, always on); 50 = the wiki's version: 50 chests per account (wiki Chests).
CHEST_ACCOUNT_CAP=0
# The time zone whose calendar days count as build site upkeep login days (every 2 login days add a day of upkeep).
# America/Los_Angeles = as live (developers, 17 Mar 2015: a day runs 12:00 AM to 11:59 PM Pacific Time); UTC = days by UTC.
UPKEEP_TIME_ZONE=America/Los_Angeles
# Seconds a character waits between two Teleport to Friend trips. 0 = none, as live from 5 May 2015 (update notes: the
# friend teleport lost its cooldown); 1800 = the 2014 alpha's 30 minutes.
FRIEND_TELEPORT_COOLDOWN_SECONDS=0
# Seconds a character waits between two trips to the Spire, and between two trips to their own build site, from the
# Travel menu. 0 = none, as live 2016 (the Stone of Recall these replaced lost its cooldown on 5 May 2015); 1800 / 3600 =
# the 2014 alpha's 30 minutes / one hour.
TRAVEL_COOLDOWN_SECONDS=0
# Accepting a friend request makes the two friends both ways: each gets the other on their friends list at once.
# true = as live (the wiki's Friends List holds the people you sent friend requests to and those whose requests you
# accepted); false = one-way lists, only the one who asked gets a new friend. Read by the world and the social service.
FRIEND_REQUESTS_MUTUAL=true
# Story creatures keep the mood and stance a Story Node gave them: saved with the spawner (with its settings), taken by
# every respawn and shown to players who arrive later. true = as live from 7 Jun 2016; false = only the players there
# when it happens see it.
STORY_POSE_PERSISTS=true
# Placing a prop from the bag (right-click a prop item) opens Build Mode on its Props page. Cancel before the first Save
# closes it again; a successful place leaves Build Mode open (Tab out when done). true = this server's default (asked for by the user); false = as live (the
# placement runs outside build mode; live's client never opened it for one).
PLACE_OPENS_BUILD_MODE=true
# Emotes (/wave, /dance, /kneel, /playdead, /emoteclip n and the client's /sit) put the held tool or weapon away and bring
# it back when the player walks off or types /stand. Without it the game shows no emote while anything is in hand (its
# animations for emotes exist only for empty hands). false = as live, the default (put the tool away yourself first);
# true = put away for the player (the game plays its put-away clip first, and taking the tool out again cuts a
# running emote: trace/0695/emotes-client.md).
EMOTES_PUT_AWAY_HELD_ITEM=false
# /yell plays the yell emote ("You yell loudly."). true = as live (the game has its own "yell" emote word and lines,
# and the 2016 command list shows it); false = /yell is a shout, as /shout always is.
YELL_IS_EMOTE=true
# Day/night clock speed in game seconds per real second. 8 = as live (wiki Astronomy: a full day/night cycle lasts 3 real
# hours; the client's own default is 8 too). The clock follows real UTC time × this speed, so it carries on across restarts
# and is the same on every world. Admins move it in game with /servertime hour|pause|sync|warp.
DAY_CYCLE_SPEED=8
# Showcase following (the page's Following tab: creators by name, tags): once a day an in-game mail to each follower
# listing what those creators listed and what was listed with those tags on Player Studio and the Gallery since the last
# mail; no mail when there is nothing new. true = as live (update notes 27 Aug 2014: a daily in-game mail about new
# items from the creators and tags you follow); false = no mail. SHOWCASE_DIGEST_HOUR_UTC = the hour it goes out (UTC,
# 0-23;
# live's hour is not known). Read by whichever side runs the digest: each world with in-process commerce, or the shared
# commerce service (one run per realm) for the worlds with COMMERCE_ADDRESS set.
SHOWCASE_FOLLOW_DIGEST=true
SHOWCASE_DIGEST_HOUR_UTC=10
# Game Finder across worlds (shared social service + a multi-world gateway): true = a player the finder took to a game on
# another world is brought back to the world, landscape and spot they left from a few seconds after leaving that game.
# false = they stay on the game's world and travel home with the Landscapes window (no source says live brought them back).
FINDER_RETURN_HOME=false
# Chaos Cavern trips across worlds (a multi-world gateway, GATEWAY_MULTI_WORLD): true = as live (update notes 7 Jun
# 2016: Lost Crystal trips may land on another world and biome): a Lost Crystal's trip and Travel -> An Underground
# Adventure
# treat this world and every other world on the gateway as equally likely, and land in a cavern there. false = trips stay
# on this world's landscapes. No effect with one world per gateway.
CAVERN_TRIPS_OTHER_WORLDS=true
# Same-landscape teleports up to this many metres move the player in place, no loading screen (0 = always re-zone).
SHORT_TELEPORT_DISTANCE=60
# Item definitions per packet when a player enters the world (the client's whole item list, ~2,960 items). The client
# takes each packet in one go on its main thread; cut up, its window keeps responding (no "Not Responding" at 16 %).
# 0 = the whole list in one packet, as the live dump has it. The client ends up with the same items either way.
ITEM_DEFINITION_CHUNK_SIZE=100
# Short moves show the client's own brief "Waiting for Teleport..." screen instead of moving inside a normal frame
# (false = default while it is measured).
SHORT_TELEPORT_WAIT_SCREEN=false
# Member benefits besides login-queue priority: Lumens every 30 days for member accounts (not trials) and percent off
# Lumen store prices for members and trials. 0 = live (Landmark had no member perks); e.g. 650 and 10 to give some.
MEMBER_MONTHLY_LUMENS=0
MEMBER_STORE_DISCOUNT=0
# Store purchases (bought for Lumens) can't be traded, mailed or put in a chest for this many hours: live's "fraud timer"
# (the client's "That item was recently purchased and may not be traded yet." / "Recent purchases can't be placed into
# chests right away."; the item tooltip shows "Tradable in %TIME"). 12 = the developer post of 26 Mar 2014 (purchases
# stay locked for at most 12 hours); 0 = tradeable at once.
STORE_TRADE_WAIT_HOURS=12
# Items that didn't fit the bag wait in the inventory's overflow tab this many hours, then they are deleted. 24 = as live
# (wiki Inventory: overflow items are lost after 24 hours; the client counts down
# "Overflow: Items expire in H:MM:SS"). 0 = overflow items are kept until retrieved.
OVERFLOW_EXPIRY_HOURS=24
# Most of one item (e.g. ore) one mail attachment may carry: 9000 = as live (wiki Trading: at most 9,000 of a gathered
# material per mail); 0 = no cap. The client has no cap of its own.
MAIL_MAX_STACK=9000
# Lumens change hands between players: offered in the trade window, sent by mail or asked for as cash on delivery.
# false = as live (the developers' Landmark Wipe Q&A of 14 March 2016: Lumens cannot be traded); true = allowed.
LUMEN_TRADING=false
# Items keep their auto-resupply switch (the client's InventoryPacketToggleAutoResupply): true = as live (the live item
# table had an auto_resupply column); false = the switch is ignored and every item is sent with it off.
ITEM_AUTO_RESUPPLY=true
# Grief: true (default) = live: in team site
# games a hit aimed at a teammate lands and earns the attacker grief: one point per GRIEF_DAMAGE_PER_POINT damage,
# levels 1-5 from GRIEF_LEVEL_POINTS (1-3 the client's warnings, 4 weapon lock, 5 suspension for
# GRIEF_SUSPENSION_MINUTES), GRIEF_DECAY_PER_HOUR points wearing off per hour. Live's own numbers are not known.
# false = teammates can't hurt each other and nothing earns grief.
GRIEF_AWARDS=true
GRIEF_DAMAGE_PER_POINT=100
GRIEF_LEVEL_POINTS=10,20,30,40,60
GRIEF_DECAY_PER_HOUR=30
GRIEF_SUSPENSION_MINUTES=60

# ---- Shared social service (optional, being built) -------------------------------------------------------------------

# Friends lists, ignore lists and who is online shared by all your worlds, in their own container (docker/social). The
# login server uses SOCIAL_ADDRESS too, for the friends lists on the character select screen.
# Off by default. To try it, set both lines below to the values in the notes, then  docker compose up -d --build
#   COMPOSE_PROFILES=social
#   SOCIAL_ADDRESS=social:20200
# On its first start it copies the existing friends and ignore lists from the character database (back up first; see
# docs/docker.md "Social service"). SOCIAL_IMPORT_FROM= (empty) skips that copy.
COMPOSE_PROFILES=
SOCIAL_ADDRESS=
# Seconds before friends see someone offline, so moving to another world shows no logout in between.
SOCIAL_PRESENCE_GRACE_SECONDS=30

# ---- Shared commerce service (optional, being built) -----------------------------------------------------------------

# Player Studio (designs for sale, peer review, the gallery listings), contests and portraits shared by all your worlds,
# in their own container (docker/commerce). Off by default. To try it, add "commerce" to COMPOSE_PROFILES (comma
# separated, e.g. social,commerce) and set COMMERCE_ADDRESS=commerce:20400, then  docker compose up -d --build
# On its first start it copies the Player Studio products, reviews and taken designs from the character database as
# world COMMERCE_IMPORT_WORLD (back up first; see docs/docker.md "Commerce service"); each world sends its own contest
# and portrait files once when it first links. COMMERCE_IMPORT_FROM= (empty) skips the database copy.
COMMERCE_ADDRESS=

# ---- Environment Server (optional, being built) ---------------------------------------------------------------------

# The first world's terrain store (build edits, digs and their heals, ore veins, Voxel Vision, LOD copies, the Spire /
# ruin stamps) in its own container (docker/envserver). Off by default. To try it, stop the world, add "envserver" to
# COMPOSE_PROFILES and set ENVSERVER_ADDRESS=envserver:20500, then  docker compose up -d --build
# On its first start it copies the world's TerrainEdits folder into server-data/worlds/<WORLD_KEY>/envserver (back up
# first; see docs/docker.md "Environment Server"). Going back to in-process later needs that folder copied back.
ENVSERVER_ADDRESS=
# Seconds the world waits at start-up for the Environment Server's index before going on without it.
ENVSERVER_STARTUP_WAIT_SECONDS=120
# Destroyed ground heals back over time (true = live; false pauses the heals, which catch up when switched on again).
ENVSERVER_HEAL_QUEUE=true
# Keep the ruin-layer records shown on the admin monitor page (bookkeeping only), and their "desired" count (0 = as
# many as are built).
ENVSERVER_RUIN_LAYERS=false
ENVSERVER_RUIN_LAYER_DESIRED=0

# ---- Gateway and world channel in their own containers (optional, being built) --------------------------------------

# Only used when you run docker/gateway (and docker/worldchannel) for a world: see docs/docker.md.
# Seconds a player stays connected while their world restarts or crashes, before going back to character select.
GATEWAY_HOLD_SECONDS=120
# Travel between worlds from the teleport window: auto = on as soon as a second world uses the same gateway (live: one
# gateway reached every world); true = on; false = one world only.
GATEWAY_MULTI_WORLD=auto
# The login service's internal address the gateway and world channel containers use (login checks, relog sessions);
# the auth container's internal port, never published. Change it only if the auth container is named differently.
#LOGIN_INTERNAL_ADDRESS=landmarkemu-login:20210
# The world channel answers trade invitations, duels and build-site likes itself (true); false = the world does.
WC_TRADE_BROKER=true
WC_ENCOUNTER_BROKER=true
WC_CLAIM_RATINGS=true

# ---- What LaunchPad shows --------------------------------------------------------------------------------------------

# The server's name, the "Account website" link (empty: the sign-up website on PUBLIC_HOST), and the game build players
# need (empty: any). News: docker/launcher/news.json.
SERVER_NAME=LandmarkEmu
WEBSITE_URL=
REQUIRED_CLIENT_BUILD=
# The patch folder (empty: docker/launcher/patches). Put the update pack (.lmpatch, made with LaunchPad: Settings > Patch
# packs > Create update pack) in it and players' LaunchPad offers it to them. Each pack is checked first with the same
# rules every player's LaunchPad uses (only Daybreak's genuine 0.695 files get through); a refused pack is moved to
# rejected/ with the reason, and "docker compose logs auth" says why. docs/launchpad.md "Server side".
PATCH_DIR=
# Optional: a Steam 0.589 copy of Landmark, mounted read-only. It must still be the unchanged 0.589 build, so it is not
# your GAME_DIR once that folder has been updated to 0.695 (keep a separate 0.589 copy for it). With it the check also
# replays every edit and patch in a pack and checks each result. Empty: they are checked by their headers here, and each
# player's LaunchPad replays them on their own copy before anything changes.
PATCH_VERIFY_STEAM_DIR=

# ---- Sign-ups --------------------------------------------------------------------------------------------------------

# Open or closed, per player address per hour, and from everyone per hour.
REGISTRATION_OPEN=true
REGISTRATIONS_PER_ADDRESS_PER_HOUR=3
REGISTRATIONS_PER_HOUR=60
# Character names RPG-style only (a capital first letter, letters only, no spaces). false = any allowed name (live's
# rule is not known).
STRICT_NAMES=false
# The character list carries each character's friends list, as on live (the game counts each world's online friends
# from it). With the shared social service (SOCIAL_ADDRESS above) the login server asks it who is online; without it
# every friend is shown offline. false = sent empty.
CHARACTER_SELECT_FRIENDS=true

# ---- Advanced (remove the # to use one) ------------------------------------------------------------------------------

# The server's copy of the game's data tables (default server-data/gamedata, made by the setup service from GAME_DIR). It
# must be the players' client build: for 0.695 clients point it at a folder with the 0.695 tables.
#GAME_DATA_DIR=
# Where this world keeps its saved files, console.log (and the five runs before it, console.0.log newest .. console.4.log)
# and dev_commands.txt (default server-data/worlds/<WORLD_KEY>).
#WORLD_DATA_DIR=
# The Environment Server's data folder when it runs in its own container (ENVSERVER_ADDRESS above; default
# <the world's data folder>/envserver).
#ENVSERVER_DATA_DIR=
# LaunchPad's news file folder (default docker/launcher; the patch folder is PATCH_DIR above).
#LAUNCHER_DIR=
# Docker network name and the website network's address range, if they clash with others on this PC.
#NETWORK_NAME=landmarkemu
#WEB_SUBNET_PREFIX=172.30.77
# One-time copies when an optional service starts for the first time (empty = no copy): see docs/docker.md.
#SOCIAL_IMPORT_FROM=lmemu_character
#COMMERCE_IMPORT_FROM=lmemu_character
#COMMERCE_IMPORT_WORLD=1
#COMMERCE_IMPORT_REALM=lmemu_character
#WC_IMPORT_FROM=lmemu_character
#ENVSERVER_IMPORT_FROM=/world-data/TerrainEdits
