# LandmarkEmu settings. Copy this file to .env, fill it in, and run:  docker compose up -d --build
# After changing a setting, run  docker compose up -d  again.
# (Lines starting with # are notes. Write values with no spaces around the =.)

# ---- Network ---------------------------------------------------------------------------------------------------------

# The address players on OTHER PCs use to reach this PC:
#   - empty: this PC only (127.0.0.1);
#   - your LAN IP (e.g. 192.168.1.20) for players on your home network;
#   - a VPN address (Tailscale, ZeroTier) or your public IP / host name for players elsewhere.
# The world server tells every game this address, so it must be one they can reach.
PUBLIC_HOST=

# Ports. Players need all but DB_PORT open (Windows Firewall, and port forwarding on your router for players outside
# your home network). The same port is used inside and outside the containers.
# Login server (UDP): the game logs in here.
LOGIN_PORT=20042
# Account service (TCP): LaunchPad and the website create accounts and log in here.
ACCOUNT_PORT=5000
# World server (UDP): the game world.
WORLD_PORT=19000
# In-game web pages (TCP): the Showcase, store and Player Studio windows.
WEB_PAGES_PORT=19001
# Account sign-up website (TCP): http://<PUBLIC_HOST>:<WEBSITE_PORT>/
WEBSITE_PORT=8080
# The database, reachable from this PC only (for tools like HeidiSQL); never open it to others.
DB_PORT=3307

# ---- Your game -------------------------------------------------------------------------------------------------------

# Your Landmark folder, the one with Landmark64.exe (forward slashes work on Windows). It is mounted read-only: the
# servers copy their data tables from it and nothing in it is changed.
GAME_DIR=C:/Program Files (x86)/Steam/steamapps/common/Landmark

# ---- Database passwords ----------------------------------------------------------------------------------------------

# Choose two long random passwords before the first start (letters and digits). They are only used between the
# containers, so you never type them anywhere else. Changing them later needs the database to be reset.
DB_ROOT_PASSWORD=
DB_PASSWORD=

# ---- Your world ------------------------------------------------------------------------------------------------------

# Short name: the world's database is lmemu_world_<WORLD_KEY>, its files are in server-data/worlds/<WORLD_KEY>.
WORLD_KEY=main
# Its id in the server list (1, 2, 3...; unique per world, never reused).
WORLD_ID=1
# Its name in the server list, a client text id: 62147 Dev Server, 560911 Courage, 560912 Liberation,
# 560913 Satisfaction (EU), 560914 Understanding (EU), 560915 Rebellion, 560916 Serenity, 560917 Determination,
# 560918 Confidence, 560919 Adventure, 560920 Gratitude, 560921 Prosperity, 560922 Success, 560923 Triumph,
# 560924 Victory, 560925 Opportunity, 560926 Inspiration.
WORLD_NAME_ID=560916

# Admins (account or character names): in-game admin commands and the /admin menu.
ADMIN_ACCOUNT=
ADMIN_2=
ADMIN_3=

# ---- What LaunchPad shows --------------------------------------------------------------------------------------------

# The server's name, the "Account website" link (empty: the sign-up website on PUBLIC_HOST), and the game build players
# need (empty: any). News: docker/launcher/news.json.
SERVER_NAME=LandmarkEmu
WEBSITE_URL=
REQUIRED_CLIENT_BUILD=

# ---- Sign-ups --------------------------------------------------------------------------------------------------------

# Open or closed, per player address per hour, and from everyone per hour.
REGISTRATION_OPEN=true
REGISTRATIONS_PER_ADDRESS_PER_HOUR=3
REGISTRATIONS_PER_HOUR=60
