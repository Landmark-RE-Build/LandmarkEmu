# LandmarkEmu network settings: the one file to edit for addresses and ports.
# start.bat copies this to network.env on its first run; edit network.env, then run start.bat again.
# (Lines starting with # are notes. Write values with no spaces around the =.)

# The address players on OTHER PCs use to reach this PC:
#   - empty: this PC only (127.0.0.1);
#   - your LAN IP (e.g. 192.168.0.20) for players on your home network;
#   - a VPN address (ZeroTier, Tailscale) or your public IP / host name for players elsewhere.
# The world server tells every game this address, so it must be one they can reach.
PUBLIC_HOST=

# Ports. Players need the first four open (Windows Firewall, and port forwarding on your router for players outside
# your home network). The same port is used inside and outside the containers.
# Login server (UDP): the game logs in here.
LOGIN_PORT=20042
# Account service (TCP): LaunchPad and the website create accounts and log in here.
ACCOUNT_PORT=5000
# World server (UDP): the game world.
WORLD_PORT=19000
# In-game web pages (TCP): the Showcase, store and Player Studio windows.
WEB_PAGES_PORT=19001
# Account sign-up website (TCP): open http://<PUBLIC_HOST>:<WEBSITE_PORT>/ in a browser.
WEBSITE_PORT=8080
# The database, reachable from this PC only (for tools like HeidiSQL); never open it to others.
DB_PORT=3307
