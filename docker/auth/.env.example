# Server settings that aren't network ones (those are in network.env). start.bat makes .env from this on its first
# run, with random passwords and your folders; you rarely need to edit it.

# Database passwords (random; every world uses the same DB_PASSWORD).
DB_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me

# Your Landmark install (read-only) and the server's game-data folder (start.bat fills it from your install).
GAME_DIR=C:/Program Files (x86)/Steam/steamapps/common/Landmark
GAME_DATA_DIR=./gameData

# What LaunchPad shows for this server: its name, the account website link (empty: made from network.env), the game
# build players need (empty = any), and the folder with news.json.
SERVER_NAME=LandmarkEmu
WEBSITE_URL=
REQUIRED_CLIENT_BUILD=
LAUNCHER_DIR=../launcher

# Sign-ups: open or closed, per player address per hour, and from everyone per hour.
REGISTRATION_OPEN=true
REGISTRATIONS_PER_ADDRESS_PER_HOUR=3
REGISTRATIONS_PER_HOUR=60
