# A second (third...) world on this PC. Copy this file to e.g. docker/worlds/liberation.env, change the values, and
# start it next to the running project (docs/docker.md, "More worlds"):
#
#   docker compose --env-file .env --env-file docker/worlds/liberation.env -p landmarkemu-world-liberation -f docker/world/docker-compose.yml up -d
#
# Everything not set here (address, passwords, game folder) comes from the project's .env.

# Short name: the world's database is lmemu_world_<WORLD_KEY>, its files are in server-data/worlds/<WORLD_KEY>.
WORLD_KEY=liberation
# Its id in the server list: unique per world (the first world is 1), never reused.
WORLD_ID=2
# Its name in the server list (the ids are listed in .env.example). 560912 = Liberation. As on live, a live world name is
# also its name in game (CLIENT_WORLD_NAME_TEXT=0).
WORLD_NAME_ID=560912

# Its own two ports (the first world uses 19000 and 19001). Open them in the firewall too.
WORLD_PORT=19010
WEB_PAGES_PORT=19011

# Admins on this world: account:<account name> or character:<character name> (docs/admin.md; a bare name still
# works for either, but can be taken away by a player registering the same name as the other kind).
ADMIN_ACCOUNT=
ADMIN_2=
ADMIN_3=
