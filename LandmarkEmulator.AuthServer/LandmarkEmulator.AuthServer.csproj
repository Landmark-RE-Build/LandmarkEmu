<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
	  <PrivateAssets>all</PrivateAssets>
	  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	</PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LandmarkEmulator.Shared\LandmarkEmulator.Shared.csproj" />
    <ProjectReference Include="..\LandmarkEmulator.WebAPI\LandmarkEmulator.WebAPI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="AuthServer.example.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
	  <None Update="Resources/ArtTints.json">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	  <!-- Item definitions (Shared/Game/ItemAppearances.cs): the world server's file, so the character list shows the
	       equipped clothing. -->
	  <ContentWithTargetPath Include="..\LandmarkEmulator.WorldServer\Resources\PacketDumps\44-CommandBase">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		  <TargetPath>Resources\PacketDumps\44-CommandBase</TargetPath>
	  </ContentWithTargetPath>
  </ItemGroup>

</Project>
