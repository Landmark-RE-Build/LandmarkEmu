<Window x:Class="LandmarkLocal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LandmarkLocal"
        Height="800" Width="640"
        MinHeight="720" MinWidth="560"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
  <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF1E2A2E" Offset="0"/>
        <GradientStop Color="#FF12181B" Offset="0.6"/>
      </LinearGradientBrush>
    </Border.Background>
    <DockPanel>
      <!-- Header (LaunchPad #lpHeader) -->
      <Border DockPanel.Dock="Top" Height="44" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
              Background="#59000000" Padding="14,0">
        <DockPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="LANDMARK" FontWeight="Bold" FontSize="16"
                       Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="LOCAL" Margin="10,0,0,0" VerticalAlignment="Bottom" FontSize="12"
                       Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
          <TextBlock DockPanel.Dock="Right" Text="Play locally on this PC" VerticalAlignment="Center"
                     Foreground="{StaticResource MutedBrush}" FontSize="12"/>
        </DockPanel>
      </Border>

      <!-- Bottom bar (LaunchPad #lpContentBottom) -->
      <Border DockPanel.Dock="Bottom" Height="84" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
              Background="#66000000" Padding="16,0">
        <DockPanel>
          <Button x:Name="PlayButton" DockPanel.Dock="Right" Content="PLAY" Width="190" Height="54"
                  Style="{StaticResource LpPlayButton}" Click="Play_Click" Margin="16,0,0,0"
                  ToolTip="Starts the servers if needed, then launches Landmark"/>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="StartButton" Content="Start" Style="{StaticResource LpButton}"
                    Width="96" Height="36" Margin="0,0,8,0" Click="Start_Click"
                    ToolTip="Start servers only (without launching the game)"/>
            <Button x:Name="StopButton" Content="Stop" Style="{StaticResource LpStopButton}"
                    Width="96" Height="36" Margin="0,0,8,0" Click="Stop_Click"/>
            <Button x:Name="RefreshButton" Content="Refresh" Style="{StaticResource LpButton}"
                    Width="96" Height="36" Click="Refresh_Click"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Activity is docked with a floor height so the taller banner/progress cannot crush it. -->
      <DockPanel Margin="16">
        <Border DockPanel.Dock="Bottom" Height="168" CornerRadius="6"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                Background="{StaticResource PanelBrush}" Margin="0,10,0,0">
          <DockPanel>
            <Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
              <TextBlock Text="ACTIVITY" FontWeight="SemiBold" FontSize="12"
                         Foreground="{StaticResource AccentBrush}"/>
            </Border>
            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="12,8"
                     FontFamily="Consolas" FontSize="12"
                     Background="Transparent" Foreground="{StaticResource MutedBrush}"
                     CaretBrush="{StaticResource TextBrush}"/>
          </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <!-- Banner + checklist -->
            <Border CornerRadius="6" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    Padding="18,14" Margin="0,0,0,12">
              <Border.Background>
                <LinearGradientBrush StartPoint="0.2,0" EndPoint="0.2,1">
                  <GradientStop Color="#2EE3A43A" Offset="0"/>
                  <GradientStop Color="#1F4FB1A6" Offset="0.4"/>
                  <GradientStop Color="#33000000" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <StackPanel>
                <TextBlock Text="LandmarkLocal" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock x:Name="StatusLabel" Text="Stopped" FontSize="14" Foreground="{StaticResource MutedBrush}"
                           Margin="0,0,0,10"/>
                <Border x:Name="StatusBanner" CornerRadius="4" Padding="10,8" Margin="0,0,0,8"
                        Background="#40000000" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                  <TextBlock x:Name="ChecklistBox" TextWrapping="Wrap" FontSize="13"
                             Foreground="{StaticResource TextBrush}"/>
                </Border>
                <ProgressBar x:Name="SetupProgress" Height="10" Margin="0,0,0,8"
                             Minimum="0" Maximum="100" Value="0" IsIndeterminate="False"
                             Visibility="Collapsed"/>
                <TextBlock Text="Your play account is also admin on this local world. PLAY starts servers if needed."
                           Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <!-- Settings card -->
            <Border CornerRadius="6" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    Background="{StaticResource PanelBrush}" Padding="16,12">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="120"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LpLabel}" Text="Landmark folder"/>
                <TextBox x:Name="LandmarkBox" Grid.Row="0" Grid.Column="1" Margin="0,4" TextChanged="Form_Changed"/>
                <Button Grid.Row="0" Grid.Column="2" Content="Browse…" Style="{StaticResource LpButton}"
                        Margin="8,4,0,4" Click="Browse_Click"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LpLabel}" Text="Account name"/>
                <TextBox x:Name="AdminBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"
                         ToolTip="Your play account — also admin on this local world."
                         TextChanged="Form_Changed"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LpLabel}" Text="Password"/>
                <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <PasswordBox x:Name="PasswordBox" Grid.Column="0" PasswordChanged="Form_Changed"
                               ToolTip="Used when you press PLAY (remembered after the first successful Play)."/>
                  <TextBlock x:Name="RememberedLabel" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"
                             Foreground="{StaticResource OkBrush}" FontSize="12" Text="Remembered"
                             Visibility="Collapsed"/>
                </Grid>

                <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center"
                            ToolTip="0.695 / 0.699 only. Raises the in-memory allocator table from 64 to 127 slots.">
                  <TextBlock Style="{StaticResource LpLabel}" Text="Slot expand" Margin="0"/>
                  <TextBlock Text="experimental" Foreground="{StaticResource DangerBrush}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
                <ComboBox x:Name="AllocatorExpandBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"
                          SelectionChanged="AllocatorExpand_Changed"
                          ToolTip="Off (default). Auto applies on 16+ logical processors. On always tries. Mismatch shows an alert and starts unpatched.">
                  <ComboBoxItem Content="Off (default)" Tag="Off"/>
                  <ComboBoxItem Content="Auto (16+ CPUs)" Tag="Auto"/>
                  <ComboBoxItem Content="On" Tag="On"/>
                </ComboBox>

                <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center"
                            ToolTip="Raise contour workers 3→5. Requires Slot expand Auto or On.">
                  <TextBlock Style="{StaticResource LpLabel}" Text="Contour threads" Margin="0"/>
                  <TextBlock Text="experimental" Foreground="{StaticResource DangerBrush}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
                <ComboBox x:Name="ContourExpandBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"
                          SelectionChanged="Form_Changed"
                          ToolTip="Off (default). Requires Slot expand. Applied only after allocator expand succeeds.">
                  <ComboBoxItem Content="Off (default)" Tag="Off"/>
                  <ComboBoxItem Content="Auto (with slot expand)" Tag="Auto"/>
                  <ComboBoxItem Content="On" Tag="On"/>
                </ComboBox>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </DockPanel>
  </Border>
</Window>
