<Application x:Class="LandmarkLocal.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- LaunchPad palette (launchpad.css :root) -->
    <Color x:Key="LpBg">#FF12181B</Color>
    <Color x:Key="LpPanel">#FF1B2327</Color>
    <Color x:Key="LpPanel2">#FF222C31</Color>
    <Color x:Key="LpLine">#FF34434A</Color>
    <Color x:Key="LpText">#FFE4EAEC</Color>
    <Color x:Key="LpMuted">#FF97A6AB</Color>
    <Color x:Key="LpAccent">#FFE3A43A</Color>
    <Color x:Key="LpAccentDark">#FFB77D1F</Color>
    <Color x:Key="LpAccentText">#FF1A1206</Color>
    <Color x:Key="LpTeal">#FF4FB1A6</Color>
    <Color x:Key="LpDanger">#FFD9685C</Color>
    <Color x:Key="LpOk">#FF7CC47F</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource LpBg}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource LpPanel}"/>
    <SolidColorBrush x:Key="Panel2Brush" Color="{StaticResource LpPanel2}"/>
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LpLine}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource LpText}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource LpMuted}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource LpAccent}"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource LpAccentText}"/>
    <SolidColorBrush x:Key="TealBrush" Color="{StaticResource LpTeal}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource LpDanger}"/>
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource LpOk}"/>

    <Style TargetType="Window">
      <Setter Property="Background" Value="{StaticResource BgBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="LpField" TargetType="Control">
      <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,6"/>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource LpField}">
      <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource TealBrush}"/>
    </Style>

    <Style TargetType="PasswordBox" BasedOn="{StaticResource LpField}">
      <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource TealBrush}"/>
    </Style>

    <Style x:Key="LpButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4" Padding="{TemplateBinding Padding}"
                    Opacity="{TemplateBinding Opacity}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#FF2A363C"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LpPlayButton" TargetType="Button" BasedOn="{StaticResource LpButton}">
      <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="6" Padding="{TemplateBinding Padding}"
                    Opacity="{TemplateBinding Opacity}">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#FFF2BB55" Offset="0"/>
                  <GradientStop Color="{StaticResource LpAccentDark}" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35" Color="#FFE3A43A"/>
              </Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="1.08"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LpStopButton" TargetType="Button" BasedOn="{StaticResource LpButton}">
      <Setter Property="Foreground" Value="#FF1A0705"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="4" Padding="{TemplateBinding Padding}"
                    Opacity="{TemplateBinding Opacity}">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#FFE07A6E" Offset="0"/>
                  <GradientStop Color="#FFA8443A" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LpLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- LaunchPad #settingsButton -->
    <Style x:Key="LpCogButton" TargetType="Button" BasedOn="{StaticResource LpButton}">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
                    Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="21"
                    Opacity="{TemplateBinding Opacity}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#FF2A363C"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LpSettingsClose" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- LaunchPad #settingsMenu button; active left accent is applied in code (BorderBrush). -->
    <Style x:Key="LpSettingsNav" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="3,0,0,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource Panel2Brush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
