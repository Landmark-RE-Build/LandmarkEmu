<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
	  <ContentWithTargetPath Include="Resources\**">
	      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		  <TargetPath>Resources\%(RecursiveDir)\%(Filename)%(Extension)</TargetPath>
	  </ContentWithTargetPath>
	  <!-- Tint definitions (Game/ArtTints.cs): the login server's file, one copy for both servers. -->
	  <ContentWithTargetPath Include="..\LandmarkEmulator.AuthServer\Resources\ArtTints.json">
	      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		  <TargetPath>Resources\ArtTints.json</TargetPath>
	  </ContentWithTargetPath>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LandmarkEmulator.Gateway\LandmarkEmulator.Gateway.csproj" />
    <ProjectReference Include="..\LandmarkEmulator.Shared\LandmarkEmulator.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="WorldServer.example.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
